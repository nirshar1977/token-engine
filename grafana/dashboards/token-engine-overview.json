{
  "uid": "token-engine-overview",
  "title": "Token Engine overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "tags": [
    "token-engine"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Spend",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "token-engine-pg"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "token-engine-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select coalesce(sum(cost_usd),0) as spend from usage.request_usage where $__timeFilter(started_at)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Saved by prompt caching",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "token-engine-pg"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "token-engine-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select coalesce(sum(cost_without_cache_usd - cost_usd),0) as saved from usage.request_usage where $__timeFilter(started_at)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Repeated content (est. tokens)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "token-engine-pg"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "token-engine-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select coalesce(sum(latest_turn_duplicate_bytes),0)/4 as tokens from usage.request_usage where $__timeFilter(started_at)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Suspected cache breaks",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "token-engine-pg"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "token-engine-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select count(*) as breaks from quality.cache_observation where suspected_cache_break and $__timeFilter(started_at)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Spend per day by developer",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "token-engine-pg"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "token-engine-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select $__timeGroupAlias(started_at, 1d), developer as metric, sum(cost_usd) as value from usage.request_usage where $__timeFilter(started_at) group by 1, 2 order by 1"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Prompt tokens per day: cache read vs full price",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "token-engine-pg"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "token-engine-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select $__timeGroupAlias(started_at, 1d), sum(cache_read_tokens) as \"cache read\", sum(cache_write_5m_tokens + cache_write_1h_tokens) as \"cache write\", sum(input_tokens) as \"uncached input\" from usage.request_usage where $__timeFilter(started_at) group by 1 order by 1"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Per developer",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "token-engine-pg"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "cost|saved"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "cost",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "token-engine-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select developer,\n       count(*) as requests,\n       sum(input_tokens + cache_write_5m_tokens + cache_write_1h_tokens + cache_read_tokens) as prompt_tokens,\n       sum(output_tokens) as output_tokens,\n       round(100.0 * sum(cache_read_tokens) / nullif(sum(input_tokens + cache_write_5m_tokens + cache_write_1h_tokens + cache_read_tokens), 0), 1) as cache_read_pct,\n       sum(cost_usd) as cost,\n       sum(cost_without_cache_usd - cost_usd) as saved_by_cache,\n       sum(latest_turn_duplicate_bytes) / 4 as repeated_tokens_est\n  from usage.request_usage\n where $__timeFilter(started_at)\n group by developer"
        }
      ]
    }
  ]
}