# Copy to .env and change every value. Never commit .env.

# Postgres password (used by both apps and Grafana)
DB_PASSWORD=change-me

# One gateway key per developer, as name:key pairs. Generate keys with:  openssl rand -hex 24
TOKENENGINE_DEVELOPER_KEYS=nir:change-me-to-a-long-random-key

# Key for the admin API and Swagger UI (send it as the x-admin-key header)
TOKENENGINE_ADMIN_KEY=change-me-to-another-long-random-key

GRAFANA_ADMIN_PASSWORD=change-me

# Provider the gateway forwards to
TOKENENGINE_UPSTREAM_URL=https://api.anthropic.com

# --- VPS only ---
# NGINX_CONF=vps
# DOMAIN=gateway.example.com
# CERTS_DIR=/etc/letsencrypt
