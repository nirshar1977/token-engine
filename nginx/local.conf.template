# Local development: plain HTTP on port 80.
upstream token_engine_gateway {
    server gateway:8080;
    keepalive 32;
}

server {
    listen 80;
    server_name _;

    # Claude Code requests carry the whole conversation and can be several MB.
    client_max_body_size 100m;

    # Health and metrics stay internal.
    location /actuator/ {
        return 404;
    }

    location / {
        proxy_pass http://token_engine_gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Streaming: never buffer, or Claude Code stalls and its keep-alive pings get lost.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
